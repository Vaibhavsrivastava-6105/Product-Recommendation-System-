# Required AI API Key for OpenAI or any OpenAI-compatible provider
AI_API_KEY=your-api-key-here

# Optional: Base URL. Defaults to OpenAI API: https://api.openai.com/v1
# If using Gemini, set to: https://generativelanguage.googleapis.com/v1beta/openai
# If using DeepSeek, set to: https://api.deepseek.com/v1
AI_BASE_URL=https://api.openai.com/v1

# Optional: Target model. Defaults to gpt-4o-mini
# If using Gemini, set to: gemini-2.5-flash
# If using DeepSeek, set to: deepseek-chat
AI_MODEL=gpt-4o-mini
